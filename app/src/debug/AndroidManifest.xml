<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      배포 게이트웨이(http://180.210.81.164)와 로컬 백엔드(http://10.0.2.2)가 모두 평문 HTTP라
      debug 빌드에서만 cleartext 를 허용한다. release 는 https 전제이므로 열지 않는다.
    -->
    <application
        android:usesCleartextTraffic="true"
        tools:ignore="UnusedAttribute">

        <!-- 워치에서 받은 세션을 확인하고 JSON 을 빼내는 개발용 화면. debug 빌드에만 존재한다. -->
        <activity
            android:name=".feature.footprint.debug.WearDebugActivity"
            android:exported="true"
            android:label="@string/wear_debug_label"
            android:theme="@style/Theme.MoaMap">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
