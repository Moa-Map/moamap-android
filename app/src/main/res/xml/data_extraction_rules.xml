<?xml version="1.0" encoding="utf-8"?><!--
   Android 12 이상의 백업/기기 이전 규칙.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- 인증 토큰은 클라우드 백업으로 빠져나가면 안 된다. -->
        <exclude
            domain="file"
            path="datastore/auth.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
