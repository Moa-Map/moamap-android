<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 세션이 화면 꺼짐 상태에서도 계속 돌아가려면 필요 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34 부터는 쓰는 타입마다 권한을 따로 선언해야 승격이 허용된다. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <!-- 기록 중 알림용. 거부해도 기록 자체는 계속된다. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      심박 권한은 API 레벨에 따라 이름이 다르다.
      API 35 이하: BODY_SENSORS / API 36 이상: health.READ_HEART_RATE
      targetSdk 가 37 이므로 둘 다 선언하고 런타임에 골라 요청한다.
    -->
    <uses-permission
        android:name="android.permission.BODY_SENSORS"
        android:maxSdkVersion="35" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <application
        android:name=".MoaMapWearApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/wear_app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="true" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".WearMainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          기록 중 프로세스를 포그라운드에 붙잡아 둔다. 이게 없으면 화면이 꺼지는 순간
          프로세스가 얼어 센서 콜백 배달이 멈춘다.
        -->
        <service
            android:name=".health.ExerciseService"
            android:exported="false"
            android:foregroundServiceType="location|health" />
    </application>

</manifest>
